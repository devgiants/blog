---
import '../styles/global.css';
import { getLocale, locales, withLang } from '../lib/i18n';

const {
  title,
  description,
  canonical,
  noindex = false,
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const locale = Astro.props.locale ?? getLocale(Astro.url);
const copy = locales[locale];
const pageTitle = title ? `${title} - devGiants` : 'devGiants';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const pageDescription = description ?? copy.common.homeIntro;
const toggleLang = locale === 'en' ? 'fr' : 'en';
const toggleHref = withLang(Astro.url.pathname, toggleLang);
const homeHref = withLang('/', locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1220" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" href="/atom.xml" title="devGiants feed" />
  </head>
  <body class="font-sans text-slate-100">
    <header class="sticky top-0 z-40 border-b border-white/10 bg-[rgba(11,18,32,0.82)] backdrop-blur-xl">
      <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
        <a href={homeHref} class="group flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-white/10 text-sm font-bold text-white shadow-soft transition-transform group-hover:scale-105">
            DG
          </span>
          <span class="leading-tight">
            <span class="block text-[0.7rem] uppercase tracking-[0.3em] text-slate-400">devGiants</span>
            <span class="block text-sm font-medium text-slate-100">tech notes</span>
          </span>
        </a>

        <nav class="hidden items-center gap-2 md:flex">
          <a class={`rounded-full px-4 py-2 text-sm transition ${currentPath.startsWith('/blog') ? 'bg-white text-slate-950' : 'text-slate-300 hover:bg-white/8 hover:text-white'}`} href={withLang('/blog/', locale)}>{copy.nav.blog}</a>
          <a class={`rounded-full px-4 py-2 text-sm transition ${currentPath.startsWith('/bio') || currentPath.startsWith('/about') ? 'bg-white text-slate-950' : 'text-slate-300 hover:bg-white/8 hover:text-white'}`} href={withLang('/bio/', locale)}>{copy.nav.bio}</a>
          <a class="rounded-full border border-white/10 px-4 py-2 text-sm text-slate-300 transition hover:border-white/20 hover:bg-white/8 hover:text-white" href={toggleHref}>
            {copy.nav.language}
          </a>
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-6xl px-4 pb-20 pt-8 sm:px-6 lg:px-8">
      <slot />
    </main>

    <footer class="mx-auto w-full max-w-6xl px-4 pb-12 sm:px-6 lg:px-8">
      <div class="glass flex flex-col gap-4 rounded-3xl px-6 py-5 text-sm text-slate-300 sm:flex-row sm:items-center sm:justify-between">
        <p>© {new Date().getFullYear()} devGiants</p>
        <p class="font-mono text-xs uppercase tracking-[0.24em] text-slate-400">{copy.common.footer}</p>
      </div>
    </footer>
  </body>
</html>
