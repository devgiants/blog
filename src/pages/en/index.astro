---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getLocale, locales, withLang } from '../../lib/i18n';

const locale = getLocale(Astro.url);
const copy = locales[locale];
const href = (path) => withLang(path, locale);
const dateLocale = locale === 'en' ? 'en-US' : 'fr-FR';
const homeKickerParts = copy.common.homeKicker.split(',').map((part) => part.trim()).filter(Boolean);

const posts = (await getCollection('posts'))
  .filter((post) => post.data.locale === locale)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout
  title="Home"
  description={copy.common.homeIntro}
  locale={locale}
>
  <section class="grid gap-8 lg:grid-cols-[1.3fr_0.9fr] lg:items-start">
    <div class="glass-strong rounded-[2rem] p-8 sm:p-10">
      <p class="font-mono text-xs uppercase tracking-[0.35em] text-amber-300">devgiants.fr</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight sm:text-5xl">
        {homeKickerParts.length > 1 ? (
          <>
            <span class="block text-slate-100">{homeKickerParts[0]},</span>
            <span class="block title-duo">{homeKickerParts.slice(1).join(', ')}</span>
          </>
        ) : (
          <span class="block title-duo">{copy.common.homeKicker}</span>
        )}
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-8 text-slate-300 sm:text-lg">
        {copy.common.homeIntro}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={href('/blog/')} class="rounded-full bg-white px-5 py-3 text-sm font-medium text-slate-950 transition hover:bg-slate-200">
          {copy.nav.blog}
        </a>
        <a href={href('/bio/')} class="rounded-full border border-white/10 bg-white/5 px-5 py-3 text-sm font-medium text-white transition hover:border-cyan-300/40 hover:bg-white/10">
          {copy.nav.bio}
        </a>
      </div>
    </div>

    <aside class="glass rounded-[2rem] p-6 sm:p-8">
      <p class="font-mono text-xs uppercase tracking-[0.32em] text-slate-400">{copy.common.focus}</p>
      <div class="mt-5 grid gap-4">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
          <h2 class="text-sm font-semibold text-slate-100">{copy.common.techBlog}</h2>
          <p class="mt-2 text-sm leading-7 text-slate-300">{copy.common.homeBlogNote}</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
          <h2 class="text-sm font-semibold text-slate-100">{copy.common.bioLabel}</h2>
          <p class="mt-2 text-sm leading-7 text-slate-300">{copy.common.homeBioNote}</p>
        </div>
      </div>
    </aside>
  </section>

  <section class="mt-16">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.32em] text-slate-400">{copy.common.featuredArticles}</p>
        <h2 class="mt-2 text-2xl font-semibold tracking-tight text-slate-100">{copy.common.techBlog}</h2>
      </div>
      <a href={href('/blog/')} class="text-sm font-medium text-cyan-300 hover:text-cyan-200">{copy.common.viewAll}</a>
    </div>

    <div class="grid gap-5 lg:grid-cols-3">
      {posts.map((post) => (
        <article class="glass-strong group rounded-3xl p-6 transition-transform duration-300 hover:-translate-y-1">
          <p class="font-mono text-xs uppercase tracking-[0.24em] text-slate-400">
            {post.data.date.toLocaleDateString(dateLocale, { year: 'numeric', month: 'short', day: '2-digit' })}
          </p>
          <h3 class="mt-3 text-xl font-semibold tracking-tight text-slate-100">
            <a href={href(`/blog/${post.data.date.getFullYear()}/${String(post.data.date.getMonth() + 1).padStart(2, '0')}/${String(post.data.date.getDate()).padStart(2, '0')}/${post.data.publicSlug ?? post.data.slug ?? post.slug}/`)}>
              {post.data.title}
            </a>
          </h3>
          <p class="mt-3 text-sm leading-7 text-slate-300">{post.data.excerpt}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
