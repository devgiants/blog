---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getLocale, locales, withLang } from '../../../lib/i18n';

export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection('posts')).filter((post) => post.data.locale === 'en').sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;
const locale = getLocale(Astro.url);
const copy = locales[locale];
const href = (path) => withLang(path, locale);
const dateLocale = locale === 'en' ? 'en-US' : 'fr-FR';
const getPostSlug = (post) => post.data.publicSlug ?? post.data.slug ?? post.slug;

function groupPosts(items) {
  const grouped = [];
  let currentKey = '';

  for (const item of items) {
    const key = item.data.date.toLocaleDateString(dateLocale, { month: 'long', year: 'numeric' });
    if (key !== currentKey) {
      currentKey = key;
      grouped.push({ type: 'heading', value: key });
    }
    grouped.push({ type: 'post', value: item });
  }

  return grouped;
}

const groups = groupPosts(page.data);
---

<BaseLayout title={`${copy.common.archive}${page.currentPage > 1 ? ` - ${page.currentPage}` : ''}`} description={copy.common.homeIntro} locale={locale}>
  <section class="mb-10 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.32em] text-slate-400">Blog</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight title-duo sm:text-5xl">{copy.common.techBlog}</h1>
    </div>
    <a href={href('/blog/tags/')} class="text-sm font-medium text-cyan-300 hover:text-cyan-200">{copy.common.tagCloud}</a>
  </section>

  <div class="space-y-10">
    {groups.map((item) =>
      item.type === 'heading' ? (
        <div class="pt-2">
          <h2 class="text-sm font-semibold uppercase tracking-[0.28em] text-slate-400">{item.value}</h2>
        </div>
      ) : (
      <article class="glass-strong rounded-3xl p-6">
          <p class="font-mono text-xs uppercase tracking-[0.24em] text-slate-400">
            {item.value.data.date.toLocaleDateString(dateLocale, {
              day: '2-digit',
              month: 'short',
              year: 'numeric',
            })}
          </p>
          <h2 class="mt-3 text-2xl font-semibold tracking-tight text-slate-100">
            <a href={href(`/blog/${item.value.data.date.getFullYear()}/${String(item.value.data.date.getMonth() + 1).padStart(2, '0')}/${String(item.value.data.date.getDate()).padStart(2, '0')}/${getPostSlug(item.value)}/`)}>
              {item.value.data.title}
            </a>
          </h2>
          <p class="mt-4 max-w-3xl text-sm leading-7 text-slate-300">{item.value.data.excerpt}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {item.value.data.tags.map((tag) => (
              <a
                href={href(`/blog/tags/${encodeURIComponent(tag)}/`)}
                class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-slate-200 transition hover:border-cyan-300/40 hover:text-cyan-200"
              >
                #{tag}
              </a>
            ))}
          </div>
        </article>
      )
    )}
  </div>

  <nav class="mt-10 flex items-center justify-between gap-4">
    {page.url.prev ? (
      <a class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-200 transition hover:border-cyan-300/40 hover:text-cyan-200" href={href(page.url.prev)}>
        {copy.common.newerPosts}
      </a>
    ) : (
      <span />
    )}
    {page.url.next ? (
      <a class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-200 transition hover:border-cyan-300/40 hover:text-cyan-200" href={href(page.url.next)}>
        {copy.common.olderPosts}
      </a>
    ) : (
      <span />
    )}
  </nav>
</BaseLayout>
