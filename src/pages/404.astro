---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocale, locales, withLang } from '../lib/i18n';

const locale = getLocale(Astro.url);
const copy = locales[locale];
---

<BaseLayout title={copy.common.notFound} description={copy.common.notFound} noindex={true} locale={locale}>
  <section class="glass-strong rounded-[2rem] p-8 sm:p-10">
    <p class="font-mono text-xs uppercase tracking-[0.32em] text-slate-400">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight title-duo sm:text-5xl">{copy.common.notFound}</h1>
    <p class="mt-4 max-w-2xl text-base leading-8 text-slate-300">
      {locale === 'en' ? 'The requested resource does not exist or has moved.' : 'La ressource demandée n’existe pas ou a été déplacée.'}
    </p>
    <a href={withLang('/', locale)} class="mt-8 inline-flex rounded-full bg-white px-5 py-3 text-sm font-medium text-slate-950 transition hover:bg-slate-200">
      {copy.common.backHome}
    </a>
  </section>
</BaseLayout>
